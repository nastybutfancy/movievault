<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#080b16">
  <meta name="description" content="MovieVault — cyfrowe archiwum fizycznej kolekcji filmów.">
  <title>MovieVault</title>
  <link rel="manifest" href="manifest.webmanifest">
  <link rel="icon" href="movievault-icon.webp" type="image/webp">
  <link rel="stylesheet" href="styles.css?v=3.1.8">
  <script src="https://unpkg.com/@zxing/library@0.21.3/umd/index.min.js" defer></script>
  <script src="app.js?v=3.1.8" defer></script>
</head>
<body>
  <div class="ambient ambient-one"></div>
  <div class="ambient ambient-two"></div>

  <header class="topbar">
    <button class="brand brand-with-logo" type="button" data-home aria-label="Przejdź na stronę główną">
      <img class="brand-logo-icon" src="movievault-icon.webp" alt="" aria-hidden="true">
      <span class="brand-wordmark">
        <strong>Movie<span>Vault</span></strong>
        <small>COLLECT <b>•</b> SCAN <b>•</b> ARCHIVE</small>
      </span>
    </button>

    <nav class="desktop-nav" aria-label="Główna nawigacja">
      <button class="nav-link active" type="button" data-home>Home</button>
      <button class="nav-link" id="collectionButton" type="button">Kolekcja</button>
      <button class="nav-link" id="addButton" type="button">Dodaj</button>
      <button class="icon-button" id="searchButton" type="button" aria-label="Szukaj">⌕</button>
    </nav>
  </header>

  <main class="app-shell">
    <section id="homePanel" class="page-panel home-panel">
      <section class="collector-hero">
        <div class="hero-copy">
          <p class="eyebrow">TWOJA KOLEKCJA.</p>
          <h1>Twój wieczór<br>filmowy.</h1>
          <p class="hero-lead">Zbieraj. Skanuj. Archiwizuj. Odkrywaj na nowo.</p>
        </div>
        <div class="hero-art" aria-hidden="true">
          <div class="shelf shelf-a"></div>
          <div class="shelf shelf-b"></div>
          <div class="projector">
            <div class="projector-reel reel-one"></div>
            <div class="projector-reel reel-two"></div>
            <div class="projector-body"></div>
            <div class="projector-beam"></div>
          </div>
        </div>
      </section>

      <section class="quick-actions" aria-label="Najważniejsze akcje">
        <button class="action-card" type="button" data-action="add">
          <span class="action-icon">＋</span>
          <span class="action-copy">
            <strong>Dodaj do kolekcji</strong>
            <small>Dodaj nowy film do swojego archiwum</small>
          </span>
          <span class="chevron">›</span>
        </button>

        <button class="action-card" type="button" data-action="scan">
          <span class="action-icon barcode-icon">▥</span>
          <span class="action-copy">
            <strong>Skanuj kod</strong>
            <small>Zeskanuj kod kreskowy wydania</small>
          </span>
          <span class="chevron">›</span>
        </button>

        <button class="action-card" type="button" data-action="random">
          <span class="action-icon">⚄</span>
          <span class="action-copy">
            <strong>Odkryj losowy film</strong>
            <small>Wylosuj coś z własnej kolekcji</small>
          </span>
          <span class="chevron">›</span>
        </button>
      </section>

      <section class="dashboard-section">
        <div class="section-heading">
          <h2><span>◷</span> Ostatnio dodane</h2>
          <button type="button" data-open-collection>Zobacz wszystkie <span>›</span></button>
        </div>
        <div id="recentMovies" class="poster-rail">
          <div class="loading-card">Ładowanie kolekcji…</div>
        </div>
      </section>

      <section class="dashboard-section">
        <div class="section-heading">
          <h2><span>▥</span> Twoje półki</h2>
        </div>
        <div id="formatShelves" class="shelf-grid">
          <button class="shelf-card" type="button" data-format="DVD">
            <span class="format-symbol disc">◉</span><strong>DVD</strong><b id="homeDvd">0</b><small>filmów</small>
          </button>
          <button class="shelf-card" type="button" data-format="Blu-ray">
            <span class="format-symbol bluray">◒</span><strong>Blu-ray</strong><b id="homeBluray">0</b><small>filmów</small>
          </button>
          <button class="shelf-card" type="button" data-format="4K UHD">
            <span class="format-symbol uhd">4K</span><strong>4K UHD</strong><b id="homeUhd">0</b><small>filmów</small>
          </button>
          <button class="shelf-card" type="button" data-format="Steelbook">
            <span class="format-symbol steelbook">▣</span><strong>Steelbook</strong><b id="homeSteelbook">0</b><small>filmów</small>
          </button>
          <button class="shelf-card" type="button" data-format="Box Set">
            <span class="format-symbol boxset">◆</span><strong>Box Set</strong><b id="homeBoxset">0</b><small>filmów</small>
          </button>
          <button class="shelf-card" type="button" data-format="VHS">
            <span class="format-symbol vhs">▰</span><strong>VHS</strong><b id="homeVhs">0</b><small>filmów</small>
          </button>
        </div>
      </section>

      <section class="dashboard-section">
        <div class="section-heading">
          <h2><span>◇</span> Odkrywaj według</h2>
        </div>
        <div class="browse-grid">
          <button type="button" data-discover="genre"><span>◈</span> Gatunku <b>›</b></button>
          <button type="button" data-discover="director"><span>▱</span> Reżysera <b>›</b></button>
          <button type="button" data-discover="year"><span>▣</span> Roku <b>›</b></button>
          <button type="button" data-discover="series"><span>▥</span> Serii <b>›</b></button>
          <button type="button" data-discover="country"><span>◎</span> Kraju <b>›</b></button>
          <button type="button" data-discover="actor"><span>◯</span> Aktora <b>›</b></button>
        </div>
      </section>

      <section class="dashboard-section">
        <div class="section-heading">
          <h2><span>▥</span> Twoja kolekcja w liczbach</h2>
        </div>
        <div class="stats-grid collector-stats">
          <article><small>Łącznie filmów</small><strong id="homeTotal">0</strong><span>Twoje archiwum</span></article>
          <article><small>Najstarszy film</small><strong id="oldestYear">—</strong><span id="oldestTitle">Brak danych</span></article>
          <article><small>Najnowszy film</small><strong id="newestYear">—</strong><span id="newestTitle">Brak danych</span></article>
          <article><small>Średnia ocena</small><strong id="averageRating">—</strong><span>TMDb</span></article>
          <article><small>Najczęstszy gatunek</small><strong id="topGenre">—</strong><span id="topGenreCount">Brak danych</span></article>
          <article><small>Najczęstszy reżyser</small><strong id="topDirector">—</strong><span id="topDirectorCount">Brak danych</span></article>
        </div>
      </section>
    </section>

    <section id="scannerPanel" class="page-panel hidden">
      <div class="panel-header">
        <div><p class="eyebrow">SKANER</p><h1>Zeskanuj wydanie</h1></div>
        <button id="closeScannerButton" class="close-button" type="button">Zamknij</button>
      </div>
      <div class="content-card scanner-card">
        <video id="preview" playsinline></video>
        <p class="hint">Umieść kod kreskowy w kadrze. Po rozpoznaniu sprawdzimy, czy film jest już w kolekcji.</p>
      </div>
    </section>

    <section id="resultPanel" class="page-panel hidden"></section>

    <section id="collectionPanel" class="page-panel hidden">
      <div class="panel-header collection-header">
        <div><p class="eyebrow">VAULT</p><h1>Twoja kolekcja</h1><p id="collectionCount">Ładowanie…</p></div>
        <button id="refreshCollectionButton" class="secondary-button" type="button">Odśwież</button>
      </div>
      <div class="collection-toolbar">
        <label><span>Szukaj w kolekcji</span><input id="collectionFilter" type="search" placeholder="Tytuł, format, półka, kod…"></label>
        <label><span>Sortowanie</span>
          <select id="collectionSort">
            <option value="newest">Najnowsze wpisy</option>
            <option value="oldest">Najstarsze wpisy</option>
            <option value="title">Tytuł A–Z</option>
            <option value="yearDesc">Rok malejąco</option>
            <option value="yearAsc">Rok rosnąco</option>
          </select>
        </label>
      </div>
      <div id="collectionResults" class="collection-grid"></div>
    </section>

    <section id="searchPanel" class="page-panel hidden">
      <div class="panel-header">
        <div><p class="eyebrow">WYSZUKIWANIE</p><h1>Przeszukaj archiwum</h1></div>
      </div>
      <div class="content-card">
        <div class="inline-search">
          <input id="searchQuery" type="search" placeholder="Wpisz tytuł filmu">
          <button id="runSearchButton" class="primary-button" type="button">Szukaj</button>
        </div>
        <div id="searchResults" class="search-results"></div>
      </div>
    </section>

    <section id="addPanel" class="page-panel hidden">
      <div class="panel-header">
        <div><p class="eyebrow">NOWY NABYTEK</p><h1>Dodaj do kolekcji</h1></div>
      </div>
      <div class="form-layout">
        <div class="content-card">
          <div class="form-grid">
            <label class="wide"><span>Kod kreskowy</span><div class="field-with-button"><input id="barcode" inputmode="numeric" placeholder="Kod EAN / UPC"><button id="scanButton" type="button">Skanuj</button></div></label>
            <label class="wide"><span>Tytuł</span><div class="field-with-button"><input id="title" placeholder="Tytuł filmu"><button id="tmdbSearchButton" type="button">Znajdź w TMDb</button></div></label>
            <label><span>Format</span><select id="format"><option>DVD</option><option>Blu-ray</option><option>4K UHD</option><option>Steelbook</option><option>Box Set</option><option>VHS</option></select></label>
            <label><span>Rok</span><input id="year" inputmode="numeric" placeholder="2002"></label>
            <label><span>Półka</span><input id="shelf" placeholder="np. Regał A / półka 2"></label>
            <label class="wide"><span>Notatki</span><textarea id="notes" rows="4" placeholder="Wydanie, stan, dodatki…"></textarea></label>
          </div>
          <div id="tmdbStatus"></div>
          <div id="tmdbResults" class="tmdb-results"></div>
          <button id="saveButton" class="primary-button save-button" type="button">Zapisz film</button>
        </div>

        <aside id="selectedMoviePanel" class="selected-movie content-card hidden">
          <img id="selectedPoster" class="hidden" alt="">
          <div><h2 id="selectedMovieTitle"></h2><p id="selectedMovieDetails"></p><p id="selectedMovieDescription"></p></div>
        </aside>
      </div>
    </section>

    <div class="legacy-stats" aria-hidden="true">
      <span id="dvd">0</span><span id="bluray">0</span><span id="uhd">0</span><span id="total">0</span>
    </div>
  </main>

  <nav class="mobile-nav" aria-label="Mobilna nawigacja">
    <button class="active" type="button" data-home>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.8 12 3l9 7.8v9.7a.5.5 0 0 1-.5.5H15v-6H9v6H3.5a.5.5 0 0 1-.5-.5z"/></svg><small>Home</small>
    </button>
    <button type="button" data-mobile-collection>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h3v16H5zM10.5 4h3v16h-3zM16 5l2.8-.7L22 18.8l-2.8.7z"/></svg><small>Kolekcja</small>
    </button>
    <button class="scan-main" type="button" data-mobile-scan>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V5a1 1 0 0 1 1-1h4M15 4h4a1 1 0 0 1 1 1v4M20 15v4a1 1 0 0 1-1 1h-4M9 20H5a1 1 0 0 1-1-1v-4M9 9h6v6H9z"/></svg><small>Skanuj</small>
    </button>
    <button type="button" data-mobile-add>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8v8M8 12h8"/></svg><small>Dodaj</small>
    </button>
    <button type="button" data-mobile-search>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg><small>Więcej</small>
    </button>
  </nav>

  <div id="randomModal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="randomTitle">
    <button class="modal-backdrop" type="button" data-close-random aria-label="Zamknij"></button>
    <div class="random-card">
      <button class="modal-close" type="button" data-close-random>×</button>
      <p class="eyebrow">CO DZIŚ Z PÓŁKI?</p>
      <div id="randomMovieContent"></div>
      <button id="drawAgainButton" class="primary-button" type="button">Losuj ponownie</button>
    </div>
  </div>
</body>
</html>
